#ifndef TEST_BENCH_H
#define TEST_BENCH_H

/** \mainpage RSE XF Test Bench Documentation
 *
 * \section sec_text_bench_intro RSE XF Test Bench
 * This test bench contains several test projects. Every project contains class(es) to test the <a href="../../../../xf/doxygen/output/html/index.html">RSE XF</a>.
 *
 * \section sec_test_bench_proj_overview Test Projects Overview
 * - \ref test01
 * - \ref test02
 * - \ref test03
 * - \ref test04
 * - \ref test05
 * - \ref test06
 *
 * \section sec_test_bench_external_links Links to related Documentation
 * - <a href="../../../../src/xf/doxygen/output/html/index.html">XF Documentation</a>
 * - <a href="../../../../src/mdw/trace/doxygen/output/html/index.html">Trace Documentation</a>
 */

/**
 * \defgroup test_bench RSE XF Test Bench
 * \brief    All tests in this Test Bench.
 *
 */
 
//  @{

/**
 * \defgroup test01 First Test Project
 * \brief    Uses StateMachine01 class to test XF.
 *
 * This test launches an instance of the StateMachine01 class and produces some output. Optionally,
 * multiple instances of StateMachine01 can be created to test the XF.
 *
 * The Test Factory (TestFactory01) instanciates 2 objects:
 * - An object of StateMachine01 which outputs the text \b "Say Hello" every second
 * - An object of StateMachine01 which outputs the text \b "Echo" every half second
 *
 * This results into the following output:
 * \image html test01-output.png "Output Received by the CoolTerm Application"
 */

/**
 * \defgroup test02 Second Test Project
 * \brief    Uses StateMachine02 class to test XF.
 *
 * This test checks again timeout handling and proper termination of a state
 * machine.
 * In case the state machine was statically/globally created, the XF must not
 * delete the object, when requested to terminate the behavior. If the
 * state-machine was created on the heap (dynamic allocation), the XF must
 * delete the state machine upon request to terminate. 
 *
 * Wether or not the state machine should be deleted is handled with the
 * 'deleteOnTerminate()' method provided by the XFBehavior interface.
 *
 * This results into the following output:
 * \image html test02-output.png "Output Received by the CoolTerm Application"
 */

/**
 * \defgroup test03 Thirth Test Project
 * \brief    Uses StateMachine03 class to test XF.
 *
 * This test checks basic event handling in state machines. In this example
 * the StateMachine03 class sends itself an \a evRestart event to change from
 * one state to another.
 *
 * This results into the following output:
 * \image html test03-output.png "Output Received by the CoolTerm Application"
 */

/**
 * \defgroup test04 Forth Test Project
 * \brief    Uses StateMachine04a and StateMachine04b class to test XF.
 *
 * Tests if timeouts are correctly cancelled. When leaving a state with a transition
 * having a timeout, without the timeout raises, the timeout must be cancelled (unscheduled).
 *
 * This results into the following output:
 * \image html test04-output.png "Output Received by the CoolTerm Application"
 *
 */
 
/**
 * \defgroup test05 Fifth Test Project
 * \brief    Uses StateMachine05a and StateMachine05b class to test XF.
 *
 * With this test multiple timeouts are added to the XF's timeout list at the same time.
 * This tests the way how new timeouts are added in relation to other timeouts (with 
 * the same timeout value) already added to the list. For more details how the objects
 * are created, please refere to the implementation of the TestFactory05 class.
 *
 * The expected output should be as follows:
 * \image html test05-output.png "Output Received by the CoolTerm Application"
 *
 * \note On the Qt platform the trace messages may not be in the right order. This is caused
 * by the fact that the timeouts are handled by separate Qt timers where the order is not 
 * predictable. More important is that the messages are received in the same timeframe arround
 * 20 milliseconds. Example:
 * \image html test05-output-qt.png "Output Received by the Qt Creator Application"
 */

/**
 * \defgroup test06 Sixth Test Project
 * \brief    Tests basic multi-threading capability of the XF. 
 *
 * In this test multiple state-machines are created, some running on the default dispatcher
 * and another with its own. There are two Blinky class instances running. One with an active
 * dispatcher and the other with the default dispatcher.
 *
 * Following sequence diagram shows what each object is doing:
 * \image html sqd-test06.png "Sequence Diagram"
 * 
 * The expected output should be as follows:
 * \image html test06-output.png "Output Received by the CoolTerm Application"
 * 
 * The LEDs on the development board should blinks as follows:
 * \image html test06-led-output.gif "LED output"
 * 
 */

// @}

#endif // TEST_BENCH_H
